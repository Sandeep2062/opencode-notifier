{
  "name": "opencode-notifier",
  "version": "1.1.0",
  "description": "Cross-platform audio and visual notifications plugin for OpenCode CLI (Windows, macOS, Linux)",
  "main": "plugin/notify.js",
  "exports": { ".": "./plugin/notify.js" },
  "files": ["plugin", "scripts/opencode-notify.ps1", "scripts/opencode-notify.sh", "sounds"],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sandeep2062/opencode-notifier.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "sounds:generate": "node scripts/generate-sounds.js",
    "test:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/opencode-notify.ps1 -Type question",
    "test:unix": "bash scripts/opencode-notify.sh question"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "notifications",
    "audio",
    "questions",
    "toast",
    "cli"
  ],
  "author": "Sandeep Khadka",
  "license": "MIT"
}
